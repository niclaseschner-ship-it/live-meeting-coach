{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nestor",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Ein Image, zentral verwaltet (scheduling_policy "default", hier weggelassen = Standard) – damit gilt
  // "constraints.jurisdiction" (anders als bei scheduling_policy "durable_object", siehe README.md
  // "EU-Prüfung"). standard-1 ist die kleinste Stufe ab 1/2 vCPU und ≥ 2 GiB (Ticket-Vorgabe); die
  // tatsächlich verfügbaren Stufen stehen in README.md.
  "containers": [
    {
      "class_name": "Nestor",
      "image": "../Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 10,
      "constraints": { "jurisdiction": "eu" }
    }
  ],

  "durable_objects": {
    "bindings": [
      { "name": "NESTOR", "class_name": "Nestor" },
      { "name": "ZAEHLER", "class_name": "KundenZaehler" },
      { "name": "RATENBEGRENZUNG", "class_name": "IpZaehler" }
    ]
  },
  // sqlite-Speicher für beide Klassen (frischer Namensraum, kein Umzug bestehender Daten nötig); v2 (Ticket
  // #63) fügt IpZaehler hinzu, ohne die bestehenden Klassen anzufassen
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Nestor", "KundenZaehler"] },
    { "tag": "v2", "new_sqlite_classes": ["IpZaehler"] }
  ],

  // Nur die Bilder der Anmeldeseite; alles andere entscheidet der Worker (run_worker_first).
  "assets": { "directory": "./oeffentlich", "binding": "ASSETS", "run_worker_first": true },

  "r2_buckets": [
    { "binding": "SPENDEN", "bucket_name": "nestor-spenden", "jurisdiction": "eu" }
  ],

  // Öffentlich, keine Geheimnisse: eigene Adresse für den Rückruf aus dem Container (Datenspende). Nach dem
  // ersten `wrangler deploy` mit der echten *.workers.dev-Adresse (oder einer eigenen Domain) füllen.
  "vars": {
    "WORKER_URL": "https://nestor.niclas-eschner.workers.dev"
  },

  // Staging (Ticket #62, Stufe C): eigener Worker `nestor-staging` mit eigenen Durable-Object-Namensräumen (eigenes
  // Skript = eigene Namensräume), eigenem R2-Bucket und höchstens einem Container. Gleiches Image wie prod. Deploy
  // NUR über `deploy/deploy.sh --staging` (oder `npx wrangler deploy --env staging`). Secrets eigens per
  // `npx wrangler secret put <NAME> --env staging`; Telegram bleibt aus (keine TELEGRAM_*-Secrets). Siehe README.md.
  "env": {
    "staging": {
      "name": "nestor-staging",
      "containers": [
        {
          "class_name": "Nestor",
          "image": "../Dockerfile",
          "instance_type": "standard-1",
          "max_instances": 1,
          "constraints": { "jurisdiction": "eu" }
        }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "NESTOR", "class_name": "Nestor" },
          { "name": "ZAEHLER", "class_name": "KundenZaehler" },
          { "name": "RATENBEGRENZUNG", "class_name": "IpZaehler" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["Nestor", "KundenZaehler"] },
        { "tag": "v2", "new_sqlite_classes": ["IpZaehler"] }
      ],
      "r2_buckets": [
        { "binding": "SPENDEN", "bucket_name": "nestor-spenden-staging", "jurisdiction": "eu" }
      ],
      "vars": {
        "WORKER_URL": "https://nestor-staging.niclas-eschner.workers.dev",
        "AUTO_FREIGABE": "0"
      }
    }
  }
}
